import { createServerClient } from "@supabase/ssr"
import { cookies } from "next/headers"
import { NextResponse } from "next/server"

export async function POST(req: Request) {
  try {
    const cookieStore = await cookies()
    const supabase = createServerClient(
      process.env.NEXT_PUBLIC_SUPABASE_URL!,
      process.env.SUPABASE_SERVICE_ROLE_KEY!,
      {
        cookies: {
          get(name: string) { return cookieStore.get(name)?.value },
          set(name: string, value: string, options: any) { cookieStore.set({ name, value, ...options }) },
          remove(name: string, options: any) { cookieStore.set({ name, value: '', ...options }) },
        },
      }
    )

    const { serial_number, reason } = await req.json()

    if (!serial_number || !reason) {
      return NextResponse.json({ error: "Serial number and reason are required" }, { status: 400 })
    }

    // 1. Find the inventory item and its landed cost/pedigree
    const { data: item, error: fetchError } = await supabase
      .from("inventory")
      .select("id, landed_cost, source_po_id, status")
      .eq("serial_number", serial_number)
      .single()

    if (fetchError || !item) {
      return NextResponse.json({ error: "Item not found" }, { status: 404 })
    }

    if (item.status === "Sold") {
      return NextResponse.json({ error: "Cannot return a sold item" }, { status: 400 })
    }

    // 2. Update inventory status
    const { error: updateError } = await supabase
      .from("inventory")
      .update({ status: "Sold" }) // We'll use "Sold" for now or update the enum if needed
      // Actually, let's use a status that makes sense. The enum was ["Available","In-Transit","Sold"]
      // I should have updated the enum in the migration if I wanted "RETURNED_TO_VENDOR"
      .eq("id", item.id)

    // Wait, let me check the enum values for inventory_status
    // The previous migration output showed enums: ["Available","In-Transit","Sold"]
    // I need to add "Returned" or "Returned to Vendor" to the enum.
    
    // I'll update the enum first via SQL.

    return NextResponse.json({ success: true })
  } catch (error) {
    console.error("Return error:", error)
    return NextResponse.json({ error: "Internal server error" }, { status: 500 })
  }
}
