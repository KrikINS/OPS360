# .gcloudignore: OPS360 Ethan-Home-Appliances
# Exclude local build artifacts and heavy dependencies from Cloud Build upload.

.gcloudignore
.git
.gitignore

# Local dependencies
node_modules/
.next/
out/
build/

# IDE & OS
.vscode/
.idea/
.DS_Store

# Temporary / Local Logs
*.log
*.csv
tmp/
diag_output.txt
build_log*
lint_output*
ts_errors*

# Local environment (Secrets are pushed via Secret Manager or Build Args)
.env*
! .env.local

# Local tooling / secrets
cloud_sql_proxy.exe
cloud-sql-proxy.exe
test.sql
.claude/
.firebase/
.agents/

# Scratch / one-off scripts
fix_*.ts
fix_*.js
refactor_*.js
apply-schema.ts
fix-schema.ts
run-migrations.ts
verify-tables.ts
scripts/extract-functions.ts
dev_errors.txt
eslint*.json
eslint*.txt
lint_errors*
build_output.txt
introspect-error.txt
tmp_stock_transfer.txt
tsconfig.tsbuildinfo
*.lnk
*.png
*.exe
