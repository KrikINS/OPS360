# ── Database ────────────────────────────────────────
# PostgreSQL connection string (Cloud SQL via proxy or direct)
DATABASE_URL=postgresql://postgres:password@localhost:5432/ops360_staging

# ── NextAuth ────────────────────────────────────────
# Random secret — generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-secret-here
# Base URL of the app (no trailing slash)
NEXTAUTH_URL=http://localhost:3000

# ── Sentry (optional) ───────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# ── Testing (optional) ──────────────────────────────
TEST_DATABASE_URL=postgresql://postgres:password@localhost:5432/ops360_test
