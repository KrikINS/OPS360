{
  "name": "tmp-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:staging": "dotenv -e .env.staging -- next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:migrate:staging": "dotenv -e .env.staging -- drizzle-kit migrate",
    "db:migrate:production--CONFIRM-BEFORE-RUNNING": "dotenv -e .env.production -- drizzle-kit migrate",
    "db:generate": "drizzle-kit generate",
    "test": "vitest",
    "test:unit": "vitest --project unit",
    "test:integration": "cross-env NODE_ENV=test vitest --project integration",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@base-ui/react": "^1.2.0",
    "@google-cloud/storage": "^7.19.0",
    "@sentry/nextjs": "^10.56.0",
    "bcrypt": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "drizzle-orm": "^0.45.2",
    "html5-qrcode": "^2.3.8",
    "lucide-react": "^0.577.0",
    "next": "16.1.6",
    "next-auth": "^4.24.14",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-to-print": "3.3.0",
    "recharts": "^3.8.0",
    "server-only": "^0.0.1",
    "swr": "^2.4.1",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.7",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "pg": "^8.21.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.7"
  }
}
